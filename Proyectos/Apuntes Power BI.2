import pandas as pd

#CARGAR INDIVIDUAL LOS 3 FICHEROS

january_2019 = pd.read_csv(r"C:\Users\formacio\Downloads\January 2019.csv")
february2019 = pd.read_csv(r"C:\Users\formacio\Downloads\February 2019.csv")

bimensual = pd.concat([january_2019,february2019])

#FUNCIÓN para poner en una nueva columna, el descuento del 0.20 0 20%, sino el descuento es 0%.
def descuento(pais):
    if pais == "Panama" or pais == "Colombia":
        return 0.20
    else:
        return 0

#LLAMAR A LA FUNCIÓN
bimensual["Descuento"] = bimensual["Country"].apply(descuento)
bimensual["Descuento"] = bimensual["Descuento"].astype(str).str.replace(".",",")


#ESTO SERÍA LO ÚLTIMO
bimensual["Revenue"] = bimensual["Revenue"].astype(str).str.replace(".",",")

#ELIMINAR LOS DF SOBRANTES
del january_2019,february2019


 


